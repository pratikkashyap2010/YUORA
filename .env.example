# Copy this file to ".env" and fill in your values. Never share or upload .env.
PORT=3000
# Admin login password (at least 10 characters). Choose a long unique one.
ADMIN_PASSWORD=
# Set to 1 once the site runs on https
COOKIE_SECURE=0
# Flat shipping charge in whole rupees (0 = free)
SHIPPING_INR=80
# UPI ID for manual QR/link payments (example: yourname@upi). Required for manual UPI checkout.
UPI_ID=9431@ptyes
# WhatsApp contact number in international format, digits only (India = 91 + number)
WHATSAPP_NUMBER=918984511929
